{
  "name": "social-grade1-quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode preview --port 4195",
    "build": "npm run build:preview",
    "build:preview": "tsc -b && vite build --mode preview",
    "build:hub": "tsc -b && vite build --mode production-hub",
    "preview:dist": "vite preview --port 4195",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "list:audio": "node scripts/list-audio-cues.ts",
    "generate:hub-seed": "node scripts/generate-hub-seed.ts",
    "validate:hub-seed": "node scripts/generate-hub-seed.ts --check",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate:hub-seed && npm run build:preview"
  },
  "dependencies": {
    "@fontsource-variable/baloo-bhaijaan-2": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
